{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**",
          "js/**",
          "Img/**",
          "public/**",
          "pwa/**",
          "react-portals/dist/**",
          "models/**/*.js",
          "routes/**/*.js",
          "services/**/*.js",
          "middleware/**/*.js",
          "config/**/*.js",
          "utils/**/*.js",
          "scripts/**/*.js",
          "server.js",
          "package.json",
          "node_modules/**"
        ],
        "excludeFiles": [
          "**/*.map",
          "**/*.md",
          "Documents/**",
          "nisrine-student-pwa/**",
          "*.rar",
          "*.zip",
          "*.bat",
          "*.ps1"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1"
  }
}

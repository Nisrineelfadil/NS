{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{*.html,404.html,favicon.ico,css/**,js/**,Img/**,public/**,pwa/**,react-portals/dist/**,models/**,routes/**,services/**,middleware/**,config/**,utils/**,server.js}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

{
  "version": 2,
  "builds": [
    {
      "src": "pwa/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**",
          "js/**",
          "Img/**",
          "public/**",
          "translations/**",
          "react-portals/dist/**",
          "models/**",
          "routes/**",
          "services/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "server.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/pwa/(.*)",
      "dest": "/pwa/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**/*.css",
          "js/**/*.js",
          "Img/*.{png,jpg,jpeg,ico}",
          "public/pwa/**",
          "pwa/*.{html,json,js,png,ico}",
          "pwa/static/**/*.{js,css,png}",
          "react-portals/dist/**",
          "models/**",
          "routes/**",
          "services/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "server.js"
        ],
        "excludeFiles": [
          "**/*.map",
          "**/*.md",
          "Documents/**",
          "Img/Video/**",
          "nisrine-student-pwa/**",
          "*.rar"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**/*.css",
          "js/**/*.js",
          "Img/**/*.{png,jpg,jpeg,ico,gif,webp}",
          "public/**",
          "pwa/**",
          "react-portals/dist/**",
          "models/**",
          "routes/**",
          "services/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "scripts/**",
          "server.js"
        ],
        "excludeFiles": [
          "**/*.map",
          "**/*.md",
          "Documents/**",
          "nisrine-student-pwa/**",
          "node_modules/**",
          "*.rar",
          "*.zip",
          "*.bat",
          "*.ps1"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

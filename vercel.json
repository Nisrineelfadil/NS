{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**",
          "js/**",
          "Img/**/*.{png,jpg,jpeg,gif,ico}",
          "public/**",
          "pwa/**",
          "translations/**",
          "react-portals/dist/**",
          "models/**",
          "routes/**",
          "services/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "server.js"
        ],
        "excludeFiles": [
          "Img/Video/**",
          "**/*.mp4",
          "**/*.avi",
          "**/*.mov",
          "Documents/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

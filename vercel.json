{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "builds": [
    {
      "src": "pwa/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**/*.css",
          "js/**/*.js",
          "Img/*.{png,jpg,jpeg,ico}",
          "public/pwa/**",
          "react-portals/dist/**",
          "models/**",
          "routes/**",
          "services/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "server.js"
        ],
        "excludeFiles": [
          "**/*.map",
          "**/*.md",
          "Documents/**",
          "Img/Video/**",
          "nisrine-student-pwa/**",
          "*.rar"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/pwa/static/(.*)",
      "dest": "/pwa/static/$1"
    },
    {
      "src": "/pwa/manifest.json",
      "dest": "/pwa/manifest.json"
    },
    {
      "src": "/pwa/service-worker.js",
      "dest": "/pwa/service-worker.js"
    },
    {
      "src": "/pwa/icon-(.*)",
      "dest": "/pwa/icon-$1"
    },
    {
      "src": "/pwa/favicon.ico",
      "dest": "/pwa/favicon.ico"
    },
    {
      "src": "/pwa/(.*)",
      "dest": "/pwa/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{*.html,404.html,favicon.ico,css/**,js/**,Img/**,public/**,pwa/**,react-portals/dist/**,models/**,routes/**,services/**,middleware/**,config/**,utils/**,server.js}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/downloads/(Nisrine-School-Admin-[0-9.]+\\.exe)",
      "headers": {
        "Content-Disposition": "attachment",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/downloads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
